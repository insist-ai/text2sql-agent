# ==========================================================
# 根目录 .gitignore
# 原则：源码与对外文档入库；密钥、模型权重、依赖环境、运行产物、本地开发笔记一律排除
# ==========================================================

# ---------- 本地开发笔记（过程记录，不对外发布）----------
dev-notes/

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
build/
wheels/
.venv/
venv/

# ---------- 密钥与本地私密配置 ----------
.env
.env.*
!.env.example
*.local.yaml
*.local.json

# ---------- 大模型权重（1.3 GB，禁止入库）----------
# 部署时按 README / docs 说明从 hf-mirror 单独下载后放到该目录
docker/embedding/
*.bin
*.safetensors
*.onnx
*.gguf

# ---------- 工作笔记（会话记忆，不对外）----------
.workbuddy/

# ---------- 日志与运行产物 ----------
logs/
*.log
backups/
.pytest_cache/
.coverage

# ---------- 前端 ----------
node_modules/
dist/
dist-ssr/
.vite/

# ---------- 评测临时产物 ----------
*.bak
*checkpoint*
# 正式评测报告（report / ablation）需入库作为论文素材，仅忽略临时目录
evaluation/_*/
evaluation/tmp/

# ---------- 编辑器与系统 ----------
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
