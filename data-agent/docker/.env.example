# ==========================================================
# NL2SQL 智能问数系统 · 部署环境变量模板
#   用法：cp .env.example .env，然后填入真实值
#   注意：.env 已被 .gitignore 排除，永远不会进仓库；本文件（.env.example）只放占位值
# ==========================================================

# ---------- 容器编排 ----------
COMPOSE_PROJECT_NAME=data-agent

# ---------- MySQL ----------
# MYSQL_ROOT_PASSWORD 仅用于容器内初始化与健康检查，应用不直接使用
MYSQL_ROOT_PASSWORD=please-set-env-MYSQL_ROOT_PASSWORD
MYSQL_USER=atguigu
MYSQL_PASSWORD=please-set-env-MYSQL_PASSWORD

# ---------- LLM 通道 ----------
# 默认走公益网关（演练用，无需充值）；论文正式数据建议切 DeepSeek 官方通道：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL_NAME=deepseek-chat
#   LLM_MODEL_NAME_CODE=deepseek-chat
#   LLM_API_KEY=<DeepSeek 官方 key>
LLM_API_KEY=please-set-env-LLM_API_KEY
LLM_BASE_URL=https://api.hcnsec.cn/v1
LLM_MODEL_NAME=longcat-2.5
LLM_MODEL_NAME_CODE=longcat-2.5

# ---------- 应用安全 ----------
# JWT 签名密钥：生产环境务必替换为高强度随机串
#   生成方式：openssl rand -hex 32
APP_JWT_SECRET_KEY=please-set-env-APP_JWT_SECRET_KEY
